{
    "name": "ctg-js-userbase",
    "version": "0.1.0",
    "description": "Reusable JS client layer for the CTG userbase API: session client, operation categories, and React presentation",
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
        "prepare": "npm run build",
        "test": "vitest run",
        "test:api": "vitest run tests/api",
        "test:live": "vitest run tests/live",
        "test:react": "vitest run tests/react",
        "test:browser": "vitest run tests/browser"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@testing-library/user-event": "^14.6.6",
        "ctg-js-browser-test": "github:claymoretechgroup/ctg-js-browser-test",
        "ctg-js-test": "claymoretechgroup/ctg-js-test",
        "ctg-react-test": "claymoretechgroup/ctg-react-test",
        "jsdom": "^25.0.0",
        "playwright": "^1.62.1",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
